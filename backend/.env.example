# Configuración del backend URPMP (copie este archivo como backend/.env para personalizar).
# Todos los valores tienen un valor por defecto: el sistema funciona sin crear .env.

# Puerto y host del servidor (use HOST=0.0.0.0 para acceder desde otros equipos de la red)
PORT=4000
HOST=127.0.0.1

# Ubicación de la base de datos SQLite y de los archivos cargados
DB_FILE=data/urpmp.sqlite
UPLOADS_DIR=data/uploads

# Carpeta del frontend compilado que el backend sirve como sitio web
FRONTEND_DIST=../frontend/dist

# Cierre de sesión por inactividad (NFR-004) y tamaño máximo de archivos (FR-025)
IDLE_TIMEOUT_MINUTES=30
MAX_FILE_SIZE_MB=25

# Selector de roles para demostraciones (permite entrar como cualquier rol). Use false en producción.
ENABLE_DEV_ROLE_SWITCHER=true

# Ponga true si sirve la plataforma por HTTPS
COOKIE_SECURE=false
