# Configuración del Entorno — URPMP Frontend (opcional: copie como frontend/.env)
VITE_API_BASE_URL=/api/v1
VITE_APP_TITLE=URPMP — Plataforma Universitaria de Gestión de Proyectos de Investigación
VITE_APP_INSTITUTION=Universidad Politécnica de Durango
VITE_IDLE_TIMEOUT_MINUTES=30
# El selector de roles de pruebas lo habilita el backend (ENABLE_DEV_ROLE_SWITCHER); aquí se puede forzar a ocultarlo con false.
VITE_ENABLE_DEV_ROLE_SWITCHER=true
VITE_AI_MAX_QUESTION_CHARS=1000
VITE_MAX_FILE_SIZE_MB=25
VITE_AUTH_PROVIDER_DEFAULT=microsoft_entra
# Solo en `npm run dev`: a dónde se reenvían las peticiones /api
VITE_API_PROXY_TARGET=http://127.0.0.1:4000
